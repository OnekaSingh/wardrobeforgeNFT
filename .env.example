PUBLIC_APP_ORIGIN=
POLYGON_RPC_URL=
WF_CRATE_CONTRACT_ADDRESS=0xB81B221d3379F21C17A6f70625d1F22a45399DAf
WF_CRATE_PRICE_USD=2.99
WF_GAS_FEE_USD=0.01
WF_CRATE_PAYMENT_RECEIPT_SECRET=
WF_PAID_MINT_SIGNER_PRIVATE_KEY=0x
WF_PAID_MINT_RELAYER_PRIVATE_KEY=0x
WF_CARD_PAYMENT_PROVIDER=
WF_ENABLE_DEMO_CARD_CHECKOUT=false

# AML / sanctions compliance controls
# Optional wallet screening provider. The endpoint should accept a JSON POST with address, chain, chainId, network, accountId, and ipCountry.
WF_AML_SCREENING_URL=
WF_AML_SCREENING_API_KEY=

# Comma-separated wallet lists. Blocked wallets cannot mint; review wallets are routed to manual review.
WF_AML_BLOCKED_WALLETS=
WF_AML_REVIEW_WALLETS=

# Comma-separated ISO country codes from hosting headers such as x-vercel-ip-country.
# Cuba, Iran, North Korea / DPRK, and Syria are blocked by default in code.
WF_AML_BLOCKED_COUNTRIES=
WF_AML_REVIEW_COUNTRIES=

# Comma-separated region/city terms. Crimea, Donetsk, and Luhansk are blocked by default when Ukraine region/city geolocation is available.
WF_AML_BLOCKED_REGIONS=

# Risk score thresholds for BLOCK, REVIEW, and step-up KYC/manual review.
WF_AML_BLOCK_SCORE=85
WF_AML_REVIEW_SCORE=50
WF_AML_KYC_SCORE=50

# Compliance audit log and manual review queue.
WF_COMPLIANCE_LOG_PATH=/tmp/wardrobeforge-compliance-events.jsonl
WF_COMPLIANCE_WEBHOOK_URL=https://app.wardrobeforge.com/api/compliance/events
WF_COMPLIANCE_WEBHOOK_TOKEN=
WF_COMPLIANCE_ADMIN_TOKEN=
